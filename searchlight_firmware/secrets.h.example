// Copy this file to secrets.h (which is gitignored) and fill in real values.
// secrets.h must NEVER be committed.

#ifndef SHIPTRACE_SECRETS_H
#define SHIPTRACE_SECRETS_H

// The ESP32 hosts this network itself (WiFi.softAP) — no venue Wi-Fi
// needed. AP_PASS must be 8-63 characters (WPA2 minimum) or "" for an
// open network.
#define AP_SSID "SHIPTRACE-BEACON"
#define AP_PASS "rescueme1"

// Demo HMAC key (32 bytes) — matches the test vectors in the spec.
// Swap for a random key before the live demo:
//   python -c "import secrets;print(secrets.token_hex(32))"
// then paste the 32 bytes below in the same {0x.., ...} format.
static const uint8_t HMAC_KEY[32] = {
  0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
  0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
  0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
  0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f
};

#endif
